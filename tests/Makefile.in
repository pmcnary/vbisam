	-rm -f ./$(DEPDIR)/detest00.Po
	-rm -f ./$(DEPDIR)/detest01.Po
	-rm -f ./$(DEPDIR)/jvntest.Po
	-rm -f ./$(DEPDIR)/mvtest.Po
	-rm -f ./$(DEPDIR)/mvtest2.Po
	-rm -f ./$(DEPDIR)/vbtest_p1.Po
	-rm -f Makefile
distclean-am: clean-am distclean-compile distclean-generic \
	distclean-tags

dvi: dvi-am

dvi-am:

html: html-am

html-am:

